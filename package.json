  "version": "1.0.0",
  "description": "Employee onboarding portal with task tracking and document management",
  "main": "server/index.js",
  "scripts": {
    "dev": "concurrently \"npm run server\" \"npm run client\"",
    "server": "tsx watch server/index.ts",
    "client": "vite",
